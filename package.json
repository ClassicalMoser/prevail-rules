{
  "name": "@classicalmoser/prevail-rules",
  "version": "0.0.1",
  "description": "Rules for the web-based board game Prevail: Ancient Battles",
  "keywords": [
    "ancient-battles",
    "board-game",
    "prevail",
    "rules",
    "typescript"
  ],
  "license": "ISC",
  "author": "ClassicalMoser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClassicalMoser/prevail-rules.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "import": "./dist/application/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "validate": "npm run lint && npm run format && npm run typecheck",
    "version:patch": "tsx scripts/version-bump.ts patch",
    "version:minor": "tsx scripts/version-bump.ts minor"
  },
  "dependencies": {
    "vite-plus": "^0.1.20",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@rolldown/binding-darwin-x64": "1.0.0-rc.18",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "classicalmoser-oxlint-config": "link:../../classicalmoser-oxlint-config",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-boundaries": "link:../../eslint-plugin-import-boundaries",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-yml": "^3.8.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tsdown": "0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "4.1.5"
  },
  "volta": {
    "node": "20.20.0",
    "pnpm": "9.7.0"
  },
  "packageManager": "pnpm@10.33.2"
}
